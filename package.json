{
  "name": "alaska-legislative-api",
  "version": "1.0.0",
  "description": "TypeScript client and scraper for the Alaska Legislature's BASIS API (https://www.akleg.gov/publicservice/basis), with optional zod validation",
  "author": "Nick Crews <n.crews@shipcreekgroup.com>",
  "license": "MIT",
  "repository": "github:ShipCreekGroup/alaska-legislative-data",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./schema.json": "./schema/basis.schema.json"
  },
  "bin": {
    "akleg": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "schema/",
    "data/curated/"
  ],
  "scripts": {
    "gen": "node scripts/gen.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test 'test/**/*.test.ts'",
    "test:live": "LIVE=1 node --test test/contract.test.ts",
    "prepublishOnly": "npm run gen && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
